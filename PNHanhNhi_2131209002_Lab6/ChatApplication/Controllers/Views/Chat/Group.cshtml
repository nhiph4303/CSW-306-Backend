@{
    ViewData["Title"] = "Group Chat";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5>Group Chat Room</h5>
                <span id="currentRoom" class="badge bg-light text-dark"></span>
            </div>
            <div class="card-body" id="chatBox" style="height: 400px; overflow-y: auto;">
                <ul id="messagesList" class="list-unstyled"></ul>
            </div>
            <div class="card-footer">
                <div class="row mb-2">
                    <div class="col-md-5">
                        <div>You</div>
                    </div>
                    <div class="col-md-5">
                        <input type="text" id="roomInput" class="form-control" placeholder="Room name" />
                    </div>
                    <div class="col-md-2">
                        <button id="joinButton" class="btn btn-success w-100">Join</button>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-10">
                        <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." disabled />
                    </div>
                    <div class="col-md-2">
                        <button id="sendButton" class="btn btn-primary w-100" disabled>Send</button>
                    </div>
                </div>
                <button id="leaveButton" class="btn btn-danger btn-sm mt-2" style="display:none;">Leave Room</button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h5>Rooms</h5>
            </div>
            <div class="card-body">
                <ul id="roomList" class="list-group"></ul>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>Navigation</h5>
            </div>
            <div class="card-body">
                <a href="/Chat/Index" class="btn btn-outline-primary btn-block mb-2 w-100">Broadcast Chat</a>
                <a href="/Chat/Group" class="btn btn-outline-success btn-block mb-2 w-100">Group Chat</a>
                <a href="/Chat/Private" class="btn btn-outline-warning btn-block w-100">Private Chat</a>
            </div>
        </div>
        <a href="#" id="logoutButton" class="btn btn-outline-danger btn-block w-100">Logout</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub", {
                accessTokenFactory: () => localStorage.getItem("jwt")
            })
            .build();

        const token = localStorage.getItem("jwt");
        if (!token) {
            console.log("No token found — redirecting to login");
            window.location.href = "/Account/Login";
        } else {
            connection.start().then(async function () {
                console.log("Connected to chat hub");
                const rooms = await connection.invoke("GetRooms");
                const roomList = document.getElementById("roomList");
                roomList.innerHTML = "";
                rooms.forEach(room => {
                    const li = document.createElement("li");
                    li.className = "list-group-item list-group-item-action";
                    li.textContent = `${room}`;
                    li.onclick = () => joinRoom(room);
                    roomList.appendChild(li);
                });
            }).catch(err => {
                console.error("Connection failed:", err);
            });
        }

        let currentRoom = null;

        connection.on("ReceiveGroupMessage", function (room, user, message, time) {
            const li = document.createElement("li");
            li.className = "mb-2 p-2";
            li.innerHTML = `<strong>${user}</strong> <small class="text-muted">(${time})</small>: ${message}`;
            document.getElementById("messagesList").appendChild(li);

            const chatBox = document.getElementById("chatBox");
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        connection.on("UserJoined", function (user, room) {
            const li = document.createElement("li");
            li.className = "mb-2 p-2 text-success";
            li.innerHTML = `<em>${user} joined the room.</em>`;
            document.getElementById("messagesList").appendChild(li);
        });

        connection.on("UserLeftRoom", function (user, room) {
            const li = document.createElement("li");
            li.className = "mb-2 p-2 text-danger";
            li.innerHTML = `<em>${user} left the room.</em>`;
            document.getElementById("messagesList").appendChild(li);
        });

        document.getElementById("joinButton").addEventListener("click", function () {
            const room = document.getElementById("roomInput").value;

            connection.invoke("JoinRoom", room).then(function () {
                currentRoom = room;
                document.getElementById("currentRoom").textContent = `Current Room: ${room}`;
                document.getElementById("messageInput").disabled = false;
                document.getElementById("sendButton").disabled = false;
                document.getElementById("leaveButton").style.display = "inline-block";
                document.getElementById("joinButton").disabled = true;
                loadChatHistory(room);
            })
        });

        document.getElementById("leaveButton").addEventListener("click", function () {
            connection.invoke("LeaveRoom", currentRoom).then(function () {
                currentRoom = null;
                document.getElementById("currentRoom").textContent = "";
                document.getElementById("messageInput").disabled = true;
                document.getElementById("sendButton").disabled = true;
                document.getElementById("leaveButton").style.display = "none";
                document.getElementById("joinButton").disabled = false;
                document.getElementById("messagesList").innerHTML = "";
            });
        });

        document.getElementById("sendButton").addEventListener("click", function () {
            const message = document.getElementById("messageInput").value;

            connection.invoke("SendGroupMessage", currentRoom, message).catch(function (err) {
                return console.error(err.toString());
            });

            document.getElementById("messageInput").value = "";
        });

        async function loadChatHistory(roomName) {
            if (!roomName) return;
            try {
                const response = await fetch(`/chat/messages/room/${encodeURIComponent(roomName)}`, {
                    headers: {
                        "Authorization": "Bearer " + localStorage.getItem("jwt")
                    }
                });
                const messages = await response.json();

                const list = document.getElementById("messagesList");
                list.innerHTML = "";
                messages.forEach(msg => {
                    const li = document.createElement("li");
                    li.className = "mb-2 p-2";
                    const time = new Date(msg.createdAt).toLocaleTimeString();
                    const sender = msg.sender?.userName || "Unknown";
                    li.innerHTML = `<strong>${sender}</strong> <small class="text-muted">(${time})</small>: ${msg.content}`;
                    list.appendChild(li);
                });

                const chatBox = document.getElementById("chatBox");
                chatBox.scrollTop = chatBox.scrollHeight;
            } catch (err) {
                console.error("Error loading history:", err);
            }
        }


        document.getElementById("logoutButton").addEventListener("click", function (event) {
            event.preventDefault();

            localStorage.removeItem("jwt");

            if (connection) {
            connection.stop();
            }

            window.location.href = "/Account/Login";
            });
    </script>
}
