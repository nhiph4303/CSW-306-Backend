@{
    ViewData["Title"] = "Broadcast Chat";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Broadcast Chat Room</h5>
            </div>
            <div class="card-body" id="chatBox" style="height: 400px; overflow-y: auto;">
                <ul id="messagesList" class="list-unstyled"></ul>
            </div>
            <div class="card-footer">
                <div class="input-group mb-2">
                    <div>You</div>
                </div>
                <div class="input-group">
                    <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
                    <button id="sendButton" class="btn btn-primary">Send</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>Navigation</h5>
            </div>
            <div class="card-body">
                <a href="/Chat/Index" class="btn btn-outline-primary btn-block mb-2 w-100">Broadcast Chat</a>
                <a href="/Chat/Group" class="btn btn-outline-success btn-block mb-2 w-100">Group Chat</a>
                <a href="/Chat/Private" class="btn btn-outline-warning btn-block w-100">Private Chat</a>
            </div>
        </div>
        <a href="#" id="logoutButton" class="btn btn-outline-danger btn-block w-100">Logout</a>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub", {
                accessTokenFactory: () => localStorage.getItem("jwt")
            })
            .build();

        const token = localStorage.getItem("jwt");
        if (!token) {
            console.log("No token found — redirecting to login");
            window.location.href = "/Account/Login";
        } else {
            connection.start().then(function () {
                console.log("Connected to chat hub");
                loadChatHistory();
            }).catch(err => {
                console.error("Connection failed:", err);
                window.location.href = "/Account/Login";
            });
        }

        connection.on("ReceiveMessage", function (user, message, time) {
            const li = document.createElement("li");
            li.className = "mb-2 p-2";
            li.innerHTML = `<strong>${user}</strong> <small class="text-muted">(${time})</small>: ${message}`;
            document.getElementById("messagesList").appendChild(li);

            const chatBox = document.getElementById("chatBox");
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        document.getElementById("sendButton").addEventListener("click", function (event) {
            const message = document.getElementById("messageInput").value;

            connection.invoke("SendMessage", message).catch(function (err) {
                return console.error(err.toString());
            });

            document.getElementById("messageInput").value = "";
            event.preventDefault();
        });

        document.getElementById("messageInput").addEventListener("keypress", function(event) {
            if (event.key === "Enter") {
                document.getElementById("sendButton").click();
            }
        });

        async function loadChatHistory() {
            try {
                const response = await fetch('/api/Chat/messages/broadcast', {
                    headers: {
                        "Authorization": "Bearer " + localStorage.getItem("jwt")
                    }
                });
                const messages = await response.json();

                messages.forEach(msg => {
                    const li = document.createElement("li");
                    li.className = "mb-2 p-2";
                    const time = new Date(msg.createdAt).toLocaleTimeString();

                    let displayName = msg.senderName || 'Unknown';
                    li.innerHTML = `<strong>${displayName}</strong> <small class="text-muted">(${time})</small>: ${msg.messageBody}`;
                    document.getElementById("messagesList").appendChild(li);
                });

                const chatBox = document.getElementById("chatBox");
                chatBox.scrollTop = chatBox.scrollHeight;
            } catch (err) {
                console.error("Error loading history:", err);
            }
        }

        document.getElementById("logoutButton").addEventListener("click", function (event) {
            event.preventDefault();

            localStorage.removeItem("jwt");

            if (connection) {
            connection.stop();
            }

            window.location.href = "/Account/Login";
            });
    </script>
}

}
